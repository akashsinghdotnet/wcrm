# ==========================================
# Wcrm Backend Environment Configuration
# ==========================================

# Server Port
PORT=4000

# Deployment Mode: 'self_hosted' (free, single/multi-company without SaaS billing) or 'cloud' (SaaS with Stripe)
DEPLOYMENT_MODE=self_hosted
APP_VERSION=1.0.0

# Database Configuration (supports 'postgres' or 'mysql')
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password
DB_NAME=wcrm
DB_SYNCHRONIZE=true

# Security & Authentication
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_here

# Meta / WhatsApp Cloud API Configuration
# Get these from https://developers.facebook.com -> Your App -> WhatsApp API Setup
# Or configure them directly in the Wcrm UI under Settings > WhatsApp
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_WABA_ID=your_whatsapp_business_account_id

# Public URLs & CORS
CLOUD_URL=https://wcrm.si
FRONTEND_URL=http://localhost:5173
COMMUNITY_FEED_URL=https://wcrm.si/community-feed.json
